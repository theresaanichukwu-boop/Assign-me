# Local device env — copy to .env (never commit .env)
# Website
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (self-hosted Postgres, no Supabase)
DATABASE_URL=postgresql://assignme:assignme@localhost:5432/assignme
POSTGRES_PASSWORD=assignme

# Auth (Better Auth)
BETTER_AUTH_SECRET=change-me-32-chars-min
BETTER_AUTH_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_xxx
EMAIL_FROM=AssignMe <noreply@yourdomain.com>

# Files (Cloudflare R2)
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET=assignme-private
R2_PUBLIC_URL=
R2_REGION=auto

# Payments (Paystack)
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxx

# AI + Research
AI_API_KEY=xxx
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
CROSSREF_MAILTO=you@example.com

# Queue / local
REDIS_URL=redis://localhost:6379
